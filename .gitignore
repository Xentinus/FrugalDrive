# ---------------------------------------------------------------------------
# FrugalDrive – root .gitignore
# Stack: C# (.NET) backend API + Nuxt frontend, running in Docker
# ---------------------------------------------------------------------------

# ===========================================================================
# Operating system
# ===========================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.fuse_hidden*
.nfs*

# ===========================================================================
# Editors / IDEs
# ===========================================================================

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.userprefs
*.sln.docstates
*.sln.iml
*.vspscc
*.vssscc
*.psess
*.vsp
*.vspx
*.opendb
*.VC.db
*.VC.VC.opendb

# JetBrains (Rider, WebStorm, IntelliJ)
.idea/
*.iml
*.ipr
*.iws

# Visual Studio Code (keep shared team config, ignore the rest)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.code-workspace

# Vim / Emacs / misc
*.swp
*.swo
*.bak
*.orig
*.rej
\#*\#
.\#*

