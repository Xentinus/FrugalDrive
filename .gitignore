# NuGet
*.nupkg
*.snupkg
.nuget/
project.lock.json
project.fragment.lock.json

# Local-only configuration & secrets
appsettings.Local.json
appsettings.*.Local.json
appsettings.*.local.json
secrets.json
*.pfx
*.p12
*.pem
*.key
*.crt

# Local databases (dev / SQLite)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.mdf
*.ldf
*.ndf

# Misc .NET tooling
StyleCopReport.xml
*.dotCover
.fake/
BenchmarkDotNet.Artifacts/
ScaffoldingReadMe.txt
healthchecksdb

# ===========================================================================
# Nuxt / Node frontend
# ===========================================================================

# Dependencies
# Lockfiles (package-lock.json / pnpm-lock.yaml / yarn.lock) are deliberately
# NOT ignored – reproducible Docker builds depend on them. Same for .nvmrc /
# .node-version, which pin the toolchain.
node_modules/
.pnp
.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions
.yarn-integrity
.pnpm-store/
jspm_packages/
web_modules/

# Nuxt build & runtime output
.nuxt/
.output/
.nitro/
.data/
dist/
.vercel/
.netlify/

# Caches
.cache/
.temp/
.tmp/
.vite/
.eslintcache
.stylelintcache
*.tsbuildinfo
.npm/
.rollup.cache/
.turbo/
.parcel-cache/

# Logs
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Testing / tooling
.nyc_output/
lib-cov/
playwright-report/
blob-report/
test-results/
.vitest/
.vscode-test/
**/.husky/_/

# npm / package tooling
# `npm pack` and `npm publish --dry-run` drop <name>-<version>.tgz here.
# If real .tgz assets are ever committed, add a "!path/to/file.tgz" exception.
*.tgz
.node_repl_history
.lock-wscript

# .npmrc is deliberately NOT ignored – projects need it for registry config.
# Never put a token in it; reference an env var instead:
#   //npm.pkg.github.com/:_authToken=${NPM_TOKEN}

# Node process / runtime files
pids/
*.pid
*.pid.lock
*.seed

# Native addon build output (node-gyp)
**/build/Release/
prebuilds/

# Serverless / misc tooling state
.serverless/
.dynamodb/
.tern-port

# ===========================================================================
# Environment variables & secrets
# (never commit real values – commit *.example templates instead)
# ===========================================================================
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
*.env.local

# ===========================================================================
# Docker
# ===========================================================================

# Per-developer compose overrides.
# Remove these two lines if your team commits a shared override file.
docker-compose.override.yml
compose.override.yml

# Any *.local.yml is treated as machine-local (e.g. compose.dev.local.yml)
*.local.yml
*.local.yaml

# Local volume / bind-mount data
.docker/data/
docker/data/
docker/volumes/
**/pgdata/
**/mysql-data/
**/mongo-data/
**/redis-data/

# ===========================================================================
# Project-local scratch
# ===========================================================================
tmp/
temp/
uploads/
storage/local/
*.local
